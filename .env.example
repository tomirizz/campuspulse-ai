# tools = real tools without LLM; gemini = live Gemini; remote = Agent Engine
AGENT_MODE=tools
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_LOCATION=global
# Local Gemini API alternative; production uses Application Default Credentials.
GEMINI_API_KEY=
ENGINE_RESOURCE_NAME=
STORAGE_BACKEND=sqlite
DATA_DIR=data
COOKIE_SECURE=false
# Optional token for public GitHub rate limits; private repositories are not supported.
GITHUB_TOKEN=
