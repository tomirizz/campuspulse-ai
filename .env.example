# auto = Gemini when Google credentials are configured; otherwise explicit tools mode.
# gemini = Vertex AI; remote = Agent Engine; tools = deterministic functions without AI.
AGENT_MODE=auto
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_LOCATION=global
ENGINE_RESOURCE_NAME=
STORAGE_BACKEND=sqlite
DATA_DIR=data
COOKIE_SECURE=false
# Owner's OAuth web client. End users only sign in to Google, no API keys.
APP_BASE_URL=http://127.0.0.1:8765
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# For Firestore/Cloud Run: stable Fernet key supplied via Google Secret Manager.
# Local SQLite automatically uses data/.calendar-token-key (0600).
GOOGLE_TOKEN_ENCRYPTION_KEY=
